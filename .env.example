# Server
PORT=3001

# Comma-separated origins allowed by CORS.
# If unset, local Vite/Webpack ports + https://macovin.com + https://www.macovin.com.
# On Railway, set explicitly (include any *.up.railway.app frontend URL during cutover):
# CORS_ORIGINS=https://macovin.com,https://www.macovin.com,https://YOUR-FRONTEND.up.railway.app
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,https://macovin.com,https://www.macovin.com

# Optional: directory for contact form storage (default: ./data)
# CONTACT_DATA_DIR=./data
